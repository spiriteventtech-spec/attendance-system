# Zero-Trust Security Environment Variables
# Add these to your backend .env or docker-compose .env file

# ── AWS Rekognition (Selfie Verification) ───────────────────────────────────
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1
REKOGNITION_CONFIDENCE_THRESHOLD=80

# ── SMTP Email Alerts (Device Mismatch, Velocity Violations) ────────────────
# For Gmail: use App Password (with 2FA enabled)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here

# ── Session Policy (override from DB) ──────────────────────────────────────
# block_new | terminate_old
# DEFAULT_SESSION_POLICY=block_new
